{
  "name": "buttertoast",
  "version": "0.1.0",
  "private": true,
  "description": "A security-first Chromium browser shell",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc && node scripts/copy-assets.cjs",
    "start": "npm run build && electron .",
    "test": "npm run build && node --test test/*.test.cjs",
    "audit:deps": "npm audit --audit-level=high",
    "test:electron": "npm run build && node scripts/test-electron.cjs",
    "scan:secrets": "node scripts/scan-secrets.cjs",
    "sbom": "node scripts/sbom.cjs",
    "package:win": "npm run build && npm run sbom && node scripts/package-windows.mjs",
    "test:toastir": "npm run build && node scripts/test-toastir.cjs",
    "test:browser": "npm run build && node scripts/test-browser.cjs",
    "test:extended": "npm run build && node scripts/test-extended.cjs",
    "test:security": "npm test && node scripts/test-electron.cjs && node scripts/test-toastir.cjs && node scripts/test-browser.cjs && node scripts/test-extended.cjs && node scripts/test-account.cjs && node scripts/test-ai.cjs && npm run audit:deps && npm run scan:secrets",
    "test:account": "npm run build && node scripts/test-account.cjs",
    "test:ai": "npm run build && node scripts/test-ai.cjs"
  },
  "devDependencies": {
    "@electron/asar": "4.3.1",
    "@electron/fuses": "2.1.3",
    "@electron/packager": "20.3.0",
    "@types/node": "^24.0.0",
    "electron": "45.2.3",
    "resedit": "2.0.3",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "@electron/asar": {
      "glob": "14.0.4",
      "minimatch": "11.0.5"
    }
  }
}
